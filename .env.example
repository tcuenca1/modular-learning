# Variables de configuración para modular-learning-cli
# Copia este archivo como .env en la raíz del proyecto

# Clave de API de Google Gemini (Obtén la tuya en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo a utilizar (por defecto: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Ruta absoluta donde se encuentra la carpeta de la universidad (material base)
RUTA_BASE_UNIVERSIDAD=C:/Universidad

# Ruta absoluta donde se almacenarán las notas generadas para Obsidian
OBSIDIAN_VAULT_PATH=C:/Users/Admin/Documents/ObsidianVault
