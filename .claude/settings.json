{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(venv/Scripts/python.exe -m pytest:*)",
      "Bash(venv/Scripts/ruff.exe check:*)",
      "Bash(venv/Scripts/ruff.exe format:*)",
      "Bash(venv/Scripts/lint-imports.exe)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx tsc -b:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Bash(git push --force:*)"
    ]
  }
}
